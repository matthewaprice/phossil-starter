{
    "name": "matthewaprice/phossil-starter",
    "description": "Starter site for phossil: routes, typed views and components that build to plain static HTML.",
    "type": "project",
    "homepage": "https://phossil.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Price",
            "email": "matthew@matthewaprice.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "matthewaprice/phossil": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\Components\\": "app/components/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Data\\": "app/data/",
            "App\\Views\\": "app/views/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "Phossil\\Composer\\CreateProject::offerGitInit"
        ],
        "build": "pnpm build && docker compose exec php php app/includes/build.php && pnpm format:build",
        "build:zip": [
            "@build",
            "rm -f dist.zip && cd dist && zip -rq ../dist.zip . -x '.*' '*/.*'"
        ],
        "test": "docker compose exec php vendor/bin/phpunit"
    }
}
